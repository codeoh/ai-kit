{
  "name": "ai-kit",
  "version": "0.1.0",
  "description": "Embed AI into your product as typed functions, not chat. Scene declarations, anti-hallucination guards, semantic contracts and zero-token golden evals.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./eval": {
      "types": "./dist/eval.d.ts",
      "import": "./dist/eval.js",
      "require": "./dist/eval.cjs"
    }
  },
  "files": [
    "dist",
    "profiles"
  ],
  "keywords": [
    "ai",
    "llm",
    "structured-output",
    "anti-hallucination",
    "eval",
    "golden-set",
    "semantic-contract",
    "typescript",
    "embed"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm test && pnpm typecheck && pnpm build"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsup": "^8.3.5",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=18"
  }
}

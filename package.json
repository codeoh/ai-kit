{
  "name": "@codeoh/ai-kit",
  "version": "0.1.0",
  "description": "Turn one AI analysis into a reusable function. Declare the shape once, get the same structured result every call — summaries, scores, recommendations with record-level citations.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./eval": {
      "types": "./dist/eval.d.mts",
      "import": "./dist/eval.mjs",
      "require": "./dist/eval.cjs"
    }
  },
  "files": [
    "dist",
    "profiles"
  ],
  "keywords": [
    "ai",
    "llm",
    "structured-output",
    "json-schema",
    "evaluation",
    "regression-test",
    "prompt",
    "typescript",
    "embed"
  ],
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm test && pnpm typecheck && pnpm build"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsdown": "^0.23.0",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=18"
  }
}
